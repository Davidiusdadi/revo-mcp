{
  "name": "revo-mcp",
  "version": "1.0.0",
  "description": "MCP server for Reta Vortaro (Esperanto dictionary) lookup",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:setup": "tsx src/setup.ts",
    "start": "tsx src/index.ts",
    "start:http": "tsx src/http.ts",
    "test": "vitest run",
    "fonto": "sh scripts/fonto.sh",
    "corpus:entities": "tsx scripts/gen-entities.ts",
    "corpus:build": "tsx src/corpus/build.ts",
    "corpus:validate": "tsx scripts/compare-db.ts",
    "corpus:eval": "tsx scripts/eval-stemming.ts",
    "corpus:eval-segment": "tsx scripts/eval-segment.ts",
    "corpus:train-segment": "tsx scripts/train-segment.ts",
    "browser:build": "tsx scripts/build-browser-worker.ts",
    "browser:smoke:build": "tsx scripts/build-browser-smoke.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.27.1",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "lru-cache": "^11.5.2",
    "sqlite-wasm-http": "1.2.0",
    "tsx": "^4.23.13",
    "voko-xml": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.1"
  }
}
